# STT Engine — contoh env
# Lokal/testing: kosongkan DATABASE_URL -> SQLite ./data/stt.db
# Produksi: isi dengan Postgres
DATABASE_URL=postgresql+psycopg://stt:postgres@localhost:5432/stt

JWT_SECRET=Rcu8uhFGjYnQb8tdXxxj8KNXIX-veYDDrXzQ9L6si-I
JWT_EXP_HOURS=12
ADMIN_USER=admin
ADMIN_PASS=admin
STT_MODEL=large-v3-turbo
# STT_MODEL=tiny

# Redis & Celery
REDIS_URL=redis://redis:6379/0

# SMTP untuk reset password via email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASSWORD=your-app-password
SMTP_TLS=true
FROM_EMAIL=your-email@gmail.com
FROM_NAME=STT Engine
# Midtrans (subscription): isi SERVER_KEY dari dashboard Midtrans (sandbox dulu)
MIDTRANS_SERVER_KEY=
MIDTRANS_SANDBOX=true
APP_BASE_URL=http://localhost:8000

# JWT: ganti dari default minimal 32 karakter di atas. Gunakan huruf/angka/symbol campuran.
# Contoh kuat: $(openssl rand -hex 16) atau frasa panjang dengan symbol