# STT Engine — contoh env
# Lokal/testing: kosongkan DATABASE_URL -> SQLite ./data/stt.db
# Produksi: isi dengan Postgres
# DATABASE_URL=postgresql+psycopg://stt:secret@localhost:5432/stt

JWT_SECRET=ganti-di-produksi
JWT_EXP_HOURS=12
ADMIN_USER=admin
ADMIN_PASS=admin
STT_MODEL=large-v3-turbo
# STT_MODEL=tiny
